# Roadstar Garage Review Assistant Configuration

# Google Gemini API Key (server-side only, never shared with client)
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=

# Port for local Node.js backend (defaults to 3001)
PORT=3001

# Public Base URL of this review web app (used for QR code generation)
# Local: http://localhost:5173
# Production example: https://roadstar-reviews.vercel.app
APP_BASE_URL=http://localhost:5173
